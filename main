from kivy.app import App
from kivy.uix.screenmanager import ScreenManager, Screen
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput
from kivy.core.window import Window
from kivy.uix.scrollview import ScrollView
from kivy.uix.image import Image
from kivy.config import Config
from instructions import *
from ruffier import *
from seconds import *
from sits import *
from runner import *


Window.clearcolor = (.99, .98, .87, 1)
text_color = (.15, .21, .09, 1)
text_secondary_color = (.99, .98, .87, 1)
btn_color = (.37, .42, .21, 1)
btn_secondary_color = (.8, .83, .68, 1)

age = 7
name = ""

# Создаем глобальные переменные для хранения результатов трех измерений пульса
P1, P2, P3 = 0, 0, 0

# Функция для безопасного преобразования введенного текста в целое число (int)
def check_int(str_num):
    try:
        # Возвращает число или False, если строка не конвертируется
        return int(str_num)
    except:
        # Если была введена не цифра (например, буквы), произойдет ошибка, и мы возвращаем False
        return False

class InstrScr(Screen):
    # Метод, который вызывается при создании (инициализации) экрана
    def __init__(self, **kwargs):
        # Обязательный вызов инициализатора родительского класса Screen
        super().__init__(**kwargs)
        # Создаем виджет картинки для "шапки" экрана. Настраиваем ее так, чтобы она растягивалась
        # (allow_stretch=True), но сохраняла пропорции (keep_ratio=True)
        header = Image(source='header.png', keep_ratio=True, size_hint_x=1, pos_hint={'x': 0, 'y': 0},allow_stretch=True)
        # Создаем текстовую метку с главным заголовком "Тест Руфье". Делаем жирный шрифт (bold) размером 34sp
        main_title = Label(text="Тест Руфье", font_size='34sp', bold=True, size_hint=(1, .3), color=text_color)
        # Создаем текстовую метку с инструкцией для пользователя (текст берем из импортированной переменной
        # txt_instruction)
        instr = Label(text=txt_instruction, size_hint_y=1, font_size='16sp', color=text_color, valign='top')
        # Создаем вертикальный контейнер (коробку) для текстовых полей ввода и кнопки. Между элементами отступ
        # spacing=8
        input_group = BoxLayout(orientation='vertical', spacing=8)
        # Создаем поле для ввода имени. multiline=False значит, что ввод только в одну строку
        self.in_name = TextInput(hint_text='Введите имя', multiline=False, size_hint=(.3, None), height='30sp',pos_hint={'center_x': 0.5})
        # Создаем поле для ввода возраста
        self.in_age = TextInput(hint_text='Введите возраст', multiline=False, size_hint=(.3, None), height='30sp',pos_hint={'center_x': 0.5})
        # Создаем кнопку "Начать"
        self.btn = Button(text='Начать', size_hint=(0.3, None), pos_hint={'center_x': .5},color=text_secondary_color, background_color=btn_color)
        # Добавляем созданные поля ввода и кнопку в контейнер input_group
        input_group.add_widget(self.in_name)
        input_group.add_widget(self.in_age)
        input_group.add_widget(self.btn)
        # Привязываем нажатие на кнопку к методу next (описан ниже)
        self.btn.on_press = self.next
        # Создаем главный (внешний) вертикальный контейнер для всего экрана. Задаем внутренние отступы (padding)
        outer = BoxLayout(orientation='vertical', padding=(8, 0, 8, 0))
        # Добавляем в него по очереди: картинку-шапку, заголовок, текст инструкции и группу с полями ввода
        outer.add_widget(header)
        outer.add_widget(main_title)
        outer.add_widget(instr)
        outer.add_widget(input_group)
        # Добавляем главный контейнер на сам экран, чтобы все отобразилось
        self.add_widget(outer)

    # Метод, который срабатывает при нажатии на кнопку "Начать"
    def next(self):
        # Меняем цвет кнопки для визуального отклика
        self.btn.color = btn_secondary_color
        # Считываем текст, который ввел пользователь в поле "Имя"
        name = self.in_name.text
        # Считываем текст из поля "Возраст" и проверяем, число ли это, с помощью нашей функции check_int
        age = check_int(self.in_age.text)
        # Если ввели не число или возраст меньше 7 (тест не для маленьких детей)
        if age == False or age < 7:
            # Принудительно ставим возраст 7
            age = 7
            # Перезаписываем текст в поле ввода на "7", чтобы пользователь это увидел
            self.in_age.text = str(age)
        else:
            # Если всё в порядке, говорим менеджеру экранов (manager) переключиться на следующий экран с именем
            # 'pulse1'
            self.manager.current = 'pulse1'
class PulseScr(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.next_screen = False
        pulse_title = Label(text='Первичное измерение пульса', font_size='34sp', bold=True, size_hint=(1, .3), color=text_color)
        instr = Label(text=txt_test1, color=text_color)
        timer_group = BoxLayout(height='30sp', size_hint=(.4, 1), pos_hint={'center_x': .5})
        self.lbl_sec = Label(text='15', size_hint=(.3, None), pos_hint={'center_x': .5})
        self.lbl_sec.bind(done=self.sec_finished)

        timer_image = Image(source='hourglass.png', allow_stretch=False, width='10sp')
        timer_group.add_widget(timer_image)
        timer_group.add_widget(self.lbl_sec)
        self.input_group = BoxLayout(orientation='vertical', spacing=8)
        self.in_result = TextInput(hint_text='Введите результат измерений', multiline=False, size_hint=(.3, .5))
        self.in_result.set_disabled(True)
        self.btn = Button(text='Начать', size_hint=(0.3, None), pos_hint={'center_x': .5}, color=text_secondary_color, background_color=btn_color)
        self.btn.on_press = self.next

        # Добавляем поле и кнопку в группу ввода
        self.input_group.add_widget(self.in_result)
        self.input_group.add_widget(self.btn)

        # Главный вертикальный контейнер для этого экрана
        outer = BoxLayout(orientation='vertical', padding=(8, 0, 8, 0), spacing=8)

        # Добавляем заголовок, инструкцию, таймер и блок ввода
        outer.add_widget(pulse_title)
        outer.add_widget(instr)
        #outer.add_widget(lbl1)  # Закомментированная строка (осталась от предыдущих версий кода)
        outer.add_widget(timer_group)
        outer.add_widget(self.input_group)

        # Размещаем все на экране
        self.add_widget(outer)

    # Метод, который вызывается автоматически, когда таймер заканчивает отсчет
    def sec_finished(self, *args):
        # Разрешаем переход на следующий экран
        self.next_screen = True
        # Разблокируем поле ввода, чтобы можно было записать пульс
        self.in_result.set_disabled(False)
        # Разблокируем кнопку
        self.btn.set_disabled(False)
        # Меняем текст на кнопке, так как таймер уже прошел
        self.btn.text = "Продолжить"

        # Убираем текущую кнопку из группы ввода
        self.input_group.remove_widget(self.btn)

        # Создаем кнопку "Назад"
        self.btn_back = Button(text='Назад', size_hint=(0.3, None), pos_hint={'center_x': .5}, color=text_secondary_color, background_color=btn_color)
        btn_group = BoxLayout(orientation='vertical', spacing=8)
        btn_group.add_widget(self.btn_back)
        # Возвращаем эту связку кнопок обратно на экран
        self.input_group.add_widget(btn_group)
        # Привязываем кнопку "Назад" к методу back
        self.btn_back.on_press = self.back
    def next(self):
        if not self.next_screen:
            self.btn.set_disabled(True)
            self.lbl_sec.start()
        else:
            global P1 
            P1 = self.check_int(self.input.text)
            if P1 == False or P1 <= 0:
                P1 = ""
                self.input.text = str(P1)
            else:
                self.manager.current = "sits"
    def back(self):
        self.manager.current = self.manager.previous()
# Класс третьего экрана (Выполнение приседаний)
class CheckSits(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        # Флаг завершения приседаний
        self.next_screen = False
        # Создаем левую часть экрана (для текста и счетчика). Занимает 80% ширины
        left_side = BoxLayout(orientation='vertical', size_hint=(.8, 1), pos_hint={'x': 0})
        # Заголовок и инструкция для приседаний
        sits_title = Label(text='Приседания', font_size='34sp', bold=True, size_hint=(1, .3), color=text_color)
        instr = Label(text=txt_sits, color=text_color)
        # Группа для таймера приседаний
        timer_group = BoxLayout(height='30sp', size_hint=(.4, 1), pos_hint={'center_x': .5})
        # Кастомный виджет Sits (Счетчик приседаний, цель - 30 приседаний)
        self.lbl_sits = Sits(30, color=text_color, font_size='75sp')
        # Картинка приседающего человека
        timer_image = Image(source='squat.png', allow_stretch=False, width='10sp')
        timer_group.add_widget(timer_image)
        timer_group.add_widget(self.lbl_sits)
        # Кнопка "Начать"
        self.btn = Button(text='Начать', size_hint=(0.3, None), pos_hint={'center_x': .5},
                          color=text_secondary_color, background_color=btn_color)
        self.btn.on_press = self.next
        # Складываем всё в левую часть
        left_side.add_widget(sits_title)
        left_side.add_widget(instr)
        left_side.add_widget(timer_group)
        left_side.add_widget(self.btn)
        # Создаем правую часть экрана. Занимает 20% ширины
        right_side = BoxLayout(size_hint=(.2, 1), pos_hint={'x': 1})
        # Кастомный виджет Runner (бегунок, который задает ритм). Всего 30 шагов, время одного шага 1.5 сек
        self.run = Runner(total=30, steptime=1.5, color=text_secondary_color, btn_color=btn_secondary_color,
                          size_hint=(0.4, 1))
        # Когда анимация бегунка заканчивается, вызываем функцию run_finished
        self.run.bind(finished=self.run_finished)
        # Добавляем бегунок в правую часть
        right_side.add_widget(self.run)
        # Главный контейнер (по умолчанию горизонтальный). Складываем в него левую и правую части
        outer = BoxLayout(padding=(8, 0, 8, 0), spacing=8)
        outer.add_widget(left_side)
        outer.add_widget(right_side)
        # Добавляем всё на экран
        self.add_widget(outer)
    # Метод, вызываемый при окончании анимации бегунка
    def run_finished(self, instance, value):
        # Снова включаем кнопку
        self.btn.set_disabled(False)
        # Меняем надпись
        self.btn.text = 'Продолжить'
        # Разрешаем переход дальше
        self.next_screen = True
    # Метод нажатия на кнопку (Начать/Продолжить)
    def next(self):
        # Если упражнение еще не выполнено
        if not self.next_screen:
            # Отключаем кнопку
            self.btn.set_disabled(True)
            # Запускаем анимацию бегунка
            self.run.start()
            # Синхронизируем значение бегунка со счетчиком приседаний на экране
            self.run.bind(value=self.lbl_sits.next)
        # Если всё выполнено
        else:
            # Переходим к экрану второго (и третьего) измерения пульса
            self.manager.current = 'pulse2'


class PulseScr2(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.next_screen = False
        self.stage = 0
        header = Image(source="header.png", keep_ratio=True, size_hint_x=1, pos_hint={'x':0,'y':0}, allow_stretch=True)
        title = Label(text='Повторные замены пульса', font_size="34sp", bold=True, size_hint=(1, 0.3), color=text_color)
        instr = Label(text=txt_test3, color=text_color)
        timer_group = BoxLayout(size_hint=(0.4, None), pos_hint={"center_x": 0.5}, padding=15)
        self.lbl_sec = Seconds(15, color=text_color,font_size="75sp")
        self.lbl_sec.bind(done=self.sec_finished)
        timer_image= Image(source='hourglass.png', allow_stretch=False, width="10sp")
        timer_group.add_widget(timer_image)
        timer_group.add_widget(self.lbl_sec)
        self.lbl1 = Label(text='Считайте пульс',font_size="16sp",color=text_color,bold=True,size_hint=(1, 0.5))
        input_group = BoxLayout(orientation="vertical", spacing=8, padding=8)
        self.in_result1 = TextInput(hint_text="Результат", multiline=False, size_hint=(0.3, 0.3), pos_hint={"center_x": 1, "center_y": 0.5})
        self.in_result2 = TextInput(hint_text="Результат после отдыха",multiline=False, size_hint=(0.3, 0.3), pos_hint={"center_x": 1, "center_y": 0.5})
        self.in_result1.set_disabled(True)
        self.in_result2.set_disabled(True)
        self.btn = Button(text="Начать", size_hint=(0.3, None), pos_hint={"center_x": 0.5}, color=text_secondary_color, background = btn_color)
        self.btn.on_press = self.next
        input_group.add_widget(self.in_result1)
        input_group.add_widget(self.in_result2)
        input_group.add_widget(self.btn2)
        outer = BoxLayout(orientation="vertical", spacing=8, padding=8)
        outer.add_widget(header)
        outer.add_widget(title)
        outer.add_widget(instr)
        outer.add_widget(self.lbl1)
        outer.add_widget(timer_group)
        outer.add_widget(input_group)
        self.add_widget(outer)
    def sec_finished(self, *args):
        if self.lbl_sec.done == True:
            if self.stage == 0:
                self.stage = 1
                self.lbl1.text = 'Отдыхайте'
                self.lbl_sec.restart(30)
                self.in_result1.set_disabled(False)
            elif self.stage == 1:
                self.stage = 2
                self.lbl1.text = 'Считайте пульс'
                self.lbl_sec.restart(15)
            elif self.stage == 2:
                self.in_result2.set_disabled(False)
                self.btn.set_disabled(False)
                self.btn.text = 'Завершить'
                self.next_screen = True
    def next(self):
        if not self.next_screen:
            self.btn.set_disabled(True)
            self.lbl_sec.start()
        else:
            global P2, P3
            P2 = check_int(self.in_result1.text)
            P3 = check_int(self.in_result2.text)
            if P2 == False:
                P2 = ''
                self.in_result1.text = str(P2)
            elif P3 == False:
                P3 = ''
                self.in_result2.text = str(P3)
            else:
                self.manager.current = 'result'

class Result(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.outer = BoxLayout(orientation="vertical", spacing=8, padding=0)
        title = Label(text="Результаты", font_size="34sp", bold=True, size_hint=(1, 0.3), color = text_color)
        self.instr = Label(text="",color = text_color, markup=True)
        self.outer.add_widget(title)
        self.outer.add_widget(self.instr)
        self.add_widget(self.outer)
        self.on_enter = self.before

    def before(self):
        global P1, P2, P3, age, name
        result = test(P1, P2, P3, age)
        self.instr.text = name + '\n' +result[0]
        image = Image(source=f'{result[1]}.png', allow_stretch=False, width="20sp")
        self.outer.add_widget(image)
class HeartCheck(App):
    def build(self):
        sm = ScreenManager()
        sm.add_widget(InstrScr(name="instr"))
        sm.add_widget(PulseScr(name="pusle1"))
        sm.add_widget(CheckSits(name="sits"))
        sm.add_widget(PulseScr2(name="pusle2"))
        sm.add_widget(Result(name="result"))
        return sm
    
HeartCheck().run()

